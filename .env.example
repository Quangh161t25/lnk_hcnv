# Sao chép thành .env (chạy local) và đặt cùng các biến này trong Vercel → Settings → Environment Variables.
# Các biến này chỉ được đọc trong api/* (phía server), không bao giờ gửi xuống trình duyệt.
GOOGLE_SERVICE_ACCOUNT_EMAIL=ten-tai-khoan@du-an.iam.gserviceaccount.com
GOOGLE_SPREADSHEET_ID=id-cua-file-google-sheet
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Trợ lý AI (tùy chọn): khóa Gemini tạo miễn phí tại https://aistudio.google.com/apikey — bỏ trống thì AI tự trả lời theo mẫu câu hỏi.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
